# ThoughtForge environment (TH-3). Copy to .env.local and fill in. Never commit real values.
# Secrets live in the Vercel project `thoughtforge` (team project-foundry) as type=sensitive.

ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# Access gate for /ask and /api/ask (TH-32 §6). Any long random string; the browser stores its
# SHA-256 as the tf_access cookie after one visit to /ask?key=<value>. Unset = open (local dev only).
# Myke sets the production and preview values with: vercel env add TF_ACCESS_KEY production --sensitive
TF_ACCESS_KEY=

# Demo mode: replay the canned session in src/cast/__fixtures__/mock-session.json (no model calls).
TF_MOCK=

# Panel email (TH-31). Outbound only; Resend sends from panel.faraday-thoughtforge.com.
# RESEND_API_KEY is sensitive: set it with `vercel env add RESEND_API_KEY production --sensitive`, never in chat.
RESEND_API_KEY=
# Where the ten panelists send (Myke's inbox) and where replies go (Fastmail, root domain).
PANEL_RECIPIENT_EMAIL=you@example.com
PANEL_REPLY_TO=panel@example.com
# Bearer for /api/email/cron and /api/email/signal. Long random string (16+ chars).
PANEL_CRON_SECRET=
# Vercel cron only sends a bearer when CRON_SECRET is set: set it to the same value as PANEL_CRON_SECRET.
CRON_SECRET=
# DRY_RUN=1: compose and log rows (resend_id='dry-run') but never call Resend. TF_MOCK=1 with DRY_RUN=1: canned compose.
DRY_RUN=

# Panel email inbound (TH-47). Resend receives on panel.faraday-thoughtforge.com and posts email.received to /api/email/inbound.
# RESEND_WEBHOOK_SECRET is the Svix signing secret from the Resend webhook page (whsec_...). Sensitive:
# vercel env add RESEND_WEBHOOK_SECRET production --sensitive   (and preview). Unset = inbound answers 503.
RESEND_WEBHOOK_SECRET=
# How the ten Signal takeaways go out: thread (ten emails, one thread) or roundtable (one email from the chair). TF-DEC-82.
PANEL_SIGNAL_MODE=thread
# The reader's first name, used once in each email's opener.
PANEL_RECIPIENT_NAME=Myke
# Who may write to the panel and get a reply (comma-separated). Default: PANEL_RECIPIENT_EMAIL.
PANEL_REPLY_ALLOWLIST=
# Loop guard: replies per thread per US Central day.
PANEL_REPLY_MAX_PER_THREAD_PER_DAY=6

# Panel day (TH-66). Read-only Linear key for the projects lane (team TH, issues moved in the last 36h).
# Sensitive: vercel env add LINEAR_API_KEY production --sensitive   (and preview). Unset = the projects lane is empty.
LINEAR_API_KEY=
# Emails per panel day, 1 to 10. The planner never makes more than 5 (weekday) or 1 (Saturday).
PANEL_MAX_DAILY=5
