# ThoughtForge environment (TH-3). Copy to .env.local and fill in. Never commit real values.
# Secrets live in the Vercel project `thoughtforge` (team project-foundry) as type=sensitive.

ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# Access gate for /ask and /api/ask (TH-32 §6). Any long random string; the browser stores its
# SHA-256 as the tf_access cookie after one visit to /ask?key=<value>. Unset = open (local dev only).
# Myke sets the production and preview values with: vercel env add TF_ACCESS_KEY production --sensitive
TF_ACCESS_KEY=

# Demo mode: replay the canned session in src/cast/__fixtures__/mock-session.json (no model calls).
TF_MOCK=

# Panel email (TH-31). Outbound only; Resend sends from panel.faraday-thoughtforge.com.
# RESEND_API_KEY is sensitive: set it with `vercel env add RESEND_API_KEY production --sensitive`, never in chat.
RESEND_API_KEY=
# Where the ten panelists send (Myke's inbox) and where replies go (Fastmail, root domain).
PANEL_RECIPIENT_EMAIL=you@example.com
PANEL_REPLY_TO=panel@example.com
# Bearer for /api/email/cron and /api/email/signal. Long random string (16+ chars).
PANEL_CRON_SECRET=
# Vercel cron only sends a bearer when CRON_SECRET is set: set it to the same value as PANEL_CRON_SECRET.
CRON_SECRET=
# DRY_RUN=1: compose and log rows (resend_id='dry-run') but never call Resend. TF_MOCK=1 with DRY_RUN=1: canned compose.
DRY_RUN=
